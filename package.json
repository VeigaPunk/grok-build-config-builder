{
  "name": "grok-build-config-builder",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:pages": "vite build --config vite.pages.config.ts",
    "build:all": "npm run build && npm run build:pages",
    "dev:fnm": "bash scripts/with-fnm.sh npm run dev",
    "build:fnm": "bash scripts/with-fnm.sh npm run build",
    "build:pages:fnm": "bash scripts/with-fnm.sh npm run build:pages",
    "server:rust": "cargo run --manifest-path rust-server/Cargo.toml --release -- --static-dir dist-static --host 0.0.0.0 --port 8080",
    "server:rust:build": "cargo build --manifest-path rust-server/Cargo.toml --release",
    "start": "bash scripts/with-fnm.sh npm run build:static && cargo run --manifest-path rust-server/Cargo.toml --release -- --static-dir dist-static --host 0.0.0.0 --port 8080",
    "build:static": "vite build --config vite.static.config.ts && node -e \"const fs=require('fs');const p='dist-static/index.static.html';if(fs.existsSync(p))fs.renameSync(p,'dist-static/index.html')\"",
    "build:static:fnm": "bash scripts/with-fnm.sh npm run build:static",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:hub": "node scripts/browser-smoke.mjs http://127.0.0.1:8080/ /workspace/screenshots/hub.png",
    "smoke:codex": "node scripts/browser-smoke.mjs http://127.0.0.1:8080/codex/ /workspace/screenshots/codex.png",
    "smoke:opencode": "node scripts/browser-smoke.mjs http://127.0.0.1:8080/opencode/ /workspace/screenshots/opencode.png"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hookform/resolvers": "^5.0.0",
    "better-auth": "^1.4.0",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.160.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.0"
  },
  "description": "Interactive Grok Build CLI config reference and patch builder",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  }
}
