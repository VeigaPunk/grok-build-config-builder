{
  "product": "codex",
  "productTitle": "Codex Titanium",
  "productTagline": "Titanium unrestricted · Godspeed · multi_agent_v2@64 · DS4CC plugins — optimal with Sekhmet",
  "configPath": "~/.codex/config.toml",
  "format": "toml",
  "versionNote": "Matches codex-titanium/titanium/config.toml · Optimal with Sekhmet https://github.com/VeigaPunk/xbrd-spark",
  "cliFlags": [
    {
      "category": "Session",
      "description": "Start interactive TUI",
      "flag": "codex"
    },
    {
      "category": "Session",
      "description": "Headless one-shot",
      "flag": "codex exec <PROMPT>"
    },
    {
      "category": "Config",
      "description": "Apply [profiles.NAME] overlay",
      "flag": "--profile <NAME>"
    },
    {
      "category": "Config",
      "description": "Override any config key",
      "flag": "-c / --config KEY=VALUE"
    },
    {
      "category": "Model",
      "description": "Model override",
      "flag": "-m / --model <MODEL>"
    },
    {
      "category": "Permissions",
      "description": "Autonomous mode",
      "flag": "--full-auto"
    },
    {
      "category": "Permissions",
      "description": "Sandbox override",
      "flag": "--sandbox <MODE>"
    },
    {
      "category": "Session",
      "description": "Working directory",
      "flag": "--cd <PATH>"
    },
    {
      "category": "Headless",
      "description": "JSON event stream (exec)",
      "flag": "--json"
    }
  ],
  "envVars": [
    {
      "category": "Paths",
      "description": "Config/state home",
      "name": "CODEX_HOME"
    },
    {
      "category": "Auth",
      "description": "API key",
      "name": "OPENAI_API_KEY"
    },
    {
      "category": "Auth",
      "description": "Base URL override",
      "name": "OPENAI_BASE_URL"
    },
    {
      "category": "Logging",
      "description": "Log filter",
      "name": "RUST_LOG"
    }
  ],
  "groups": [
    {
      "id": "core",
      "title": "Core",
      "description": "Model and system prompt"
    },
    {
      "id": "sandbox",
      "title": "Sandbox & approvals",
      "description": "Sandbox mode and approval policy"
    },
    {
      "id": "agents",
      "title": "Agents & multi-agent",
      "description": "Multi-agent v2, depth, concurrency"
    },
    {
      "id": "features",
      "title": "Features",
      "description": "Feature flags"
    },
    {
      "id": "reasoning",
      "title": "Reasoning",
      "description": "Effort"
    },
    {
      "id": "web",
      "title": "Web search",
      "description": "Web search tool"
    },
    {
      "id": "plugins",
      "title": "Marketplaces & plugins",
      "description": "DS4CC and plugin sources"
    }
  ],
