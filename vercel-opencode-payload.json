{"target":"production","name":"opencode-titanium-config","teamId":"team_aVi0GXZkfVHw4Ko10VG06Qbx","projectSettings":{"framework":null,"buildCommand":null,"installCommand":null,"outputDirectory":null},"files":[{"file":"index.html","data":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>opencode Titanium Config Builder</title>\n<style>\n/* JetBrains Mono NL Nerd Font — always */\n@font-face {\n  font-family: \"JetBrainsMonoNL Nerd Font Mono\";\n  src: url(\"https://cdn.jsdelivr.net/gh/ryanoasis/nerd-fonts@v3.3.0/patched-fonts/JetBrainsMono/NoLigatures/Regular/JetBrainsMonoNLNerdFontMono-Regular.ttf\") format(\"truetype\");\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"JetBrainsMonoNL Nerd Font Mono\";\n  src: url(\"https://cdn.jsdelivr.net/gh/ryanoasis/nerd-fonts@v3.3.0/patched-fonts/JetBrainsMono/NoLigatures/Medium/JetBrainsMonoNLNerdFontMono-Medium.ttf\") format(\"truetype\");\n  font-weight: 500;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"JetBrainsMonoNL Nerd Font Mono\";\n  src: url(\"https://cdn.jsdelivr.net/gh/ryanoasis/nerd-fonts@v3.3.0/patched-fonts/JetBrainsMono/NoLigatures/SemiBold/JetBrainsMonoNLNerdFontMono-SemiBold.ttf\") format(\"truetype\");\n  font-weight: 600;\n  font-style: normal;\n  font-display: swap;\n}\n@font-face {\n  font-family: \"JetBrainsMonoNL Nerd Font Mono\";\n  src: url(\"https://cdn.jsdelivr.net/gh/ryanoasis/nerd-fonts@v3.3.0/patched-fonts/JetBrainsMono/NoLigatures/Bold/JetBrainsMonoNLNerdFontMono-Bold.ttf\") format(\"truetype\");\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n\n:root {\n  --bg: #0a0a0b;\n  --bg-elevated: #121214;\n  --bg-subtle: #1a1a1e;\n  --fg: #f4f4f5;\n  --fg-muted: #a1a1aa;\n  --fg-subtle: #71717a;\n  --border: color-mix(in oklab, var(--fg) 12%, transparent);\n  --border-strong: color-mix(in oklab, var(--fg) 22%, transparent);\n  --accent: #c8ccd4;\n  --accent-fg: #0a0a0b;\n  --success: #6ee7b7;\n  --radius-xs: 4px;\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --radius-xl: 24px;\n  --font: \"JetBrainsMonoNL Nerd Font Mono\", \"JetBrains Mono NL\", ui-monospace, monospace;\n  --mono: \"JetBrainsMonoNL Nerd Font Mono\", \"JetBrains Mono NL\", ui-monospace, monospace;\n  --shadow: 0 8px 30px color-mix(in oklab, #000 35%, transparent);\n}\n\n*, *::before, *::after { box-sizing: border-box; border-color: var(--border); }\nhtml { color-scheme: dark; overflow-x: hidden; }\nbody {\n  margin: 0;\n  min-height: 100dvh;\n  overflow-x: hidden;\n  background: var(--bg);\n  color: var(--fg);\n  font-family: var(--font);\n  font-size: 14px;\n  line-height: 1.5;\n  font-variant-ligatures: none;\n  -webkit-font-smoothing: antialiased;\n}\nbutton, input, select, textarea, pre, code {\n  font-family: inherit;\n  font-variant-ligatures: none;\n}\nbutton:not(:disabled), [role=\"button\"]:not(:disabled) { cursor: pointer; }\n:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n.mono { font-family: var(--mono); }\n.panel {\n  background: var(--bg-elevated);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-xl);\n}\n.badge {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-subtle);\n  color: var(--fg-muted);\n  font-size: 12px;\n  font-weight: 500;\n  padding: 2px 10px;\n}\n.badge.success {\n  border-color: color-mix(in oklab, var(--success) 30%, transparent);\n  background: color-mix(in oklab, var(--success) 10%, transparent);\n  color: var(--success);\n}\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 40px;\n  padding: 8px 16px;\n  border-radius: var(--radius-sm);\n  border: 1px solid transparent;\n  font-size: 13px;\n  font-weight: 500;\n  transition: opacity 150ms, transform 150ms, border-color 150ms;\n  background: var(--accent);\n  color: var(--accent-fg);\n}\n.btn:active { transform: scale(0.98); }\n.btn:hover { opacity: 0.9; }\n.btn.secondary {\n  background: var(--bg-subtle);\n  color: var(--fg);\n  border-color: var(--border);\n}\n.btn.secondary:hover { border-color: var(--border-strong); }\n.btn.outline {\n  background: transparent;\n  color: var(--fg);\n  border-color: var(--border);\n}\n.btn.ghost {\n  background: transparent;\n  color: var(--fg-muted);\n}\n.btn.sm { min-height: 32px; padding: 4px 12px; font-size: 12px; border-radius: var(--radius-xs); }\n.btn.pill {\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-elevated);\n  color: var(--fg-muted);\n}\n.btn.pill.active {\n  background: var(--accent);\n  color: var(--accent-fg);\n  border-color: transparent;\n}\n\nheader.app {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  border-bottom: 1px solid var(--border);\n  background: color-mix(in oklab, var(--bg) 90%, transparent);\n  backdrop-filter: blur(12px);\n}\n.wrap {\n  width: 100%;\n  max-width: 80rem;\n  margin: 0 auto;\n  padding: 16px;\n  min-width: 0;\n}\n@media (min-width: 640px) {\n  .wrap { padding: 16px 24px; }\n}\n.eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--fg-subtle);\n}\nh1 {\n  margin: 4px 0 0;\n  font-size: clamp(1.35rem, 3vw, 1.65rem);\n  font-weight: 600;\n  letter-spacing: -0.02em;\n}\n.lede {\n  margin: 4px 0 0;\n  max-width: 42rem;\n  font-size: 13px;\n  color: var(--fg-muted);\n}\n.row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n}\n.header-top {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 16px;\n  align-items: flex-start;\n}\n.tabs { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n\nmain.wrap { padding-top: 24px; padding-bottom: 48px; }\n\n.layout {\n  display: grid;\n  gap: 24px;\n  min-width: 0;\n}\n@media (min-width: 1024px) {\n  .layout { grid-template-columns: 240px minmax(0, 1fr); }\n}\n\n.sidebar { display: none; min-width: 0; }\n@media (min-width: 1024px) {\n  .sidebar {\n    display: block;\n    position: sticky;\n    top: 9rem;\n    align-self: start;\n  }\n}\n.sidebar .panel, .mobile-strip .panel { padding: 16px; margin-bottom: 16px; }\n.sidebar h3, .section-label {\n  margin: 0 0 8px;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--fg-subtle);\n}\n.preset-btn {\n  width: 100%;\n  text-align: left;\n  border: 1px solid var(--border);\n  background: var(--bg-subtle);\n  color: var(--fg);\n  border-radius: var(--radius-md);\n  padding: 10px 12px;\n  margin-bottom: 8px;\n}\n.preset-btn:hover { border-color: var(--border-strong); }\n.preset-btn strong { display: block; font-size: 13px; }\n.preset-btn span { display: block; margin-top: 2px; font-size: 11px; color: var(--fg-muted); }\n\n.mobile-strip { display: block; min-width: 0; }\n@media (min-width: 1024px) { .mobile-strip { display: none; } }\n.mobile-presets {\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n  scrollbar-width: thin;\n}\n.mobile-presets .btn { flex-shrink: 0; }\n\n.search {\n  width: 100%;\n  min-height: 40px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border);\n  background: var(--bg-subtle);\n  color: var(--fg);\n  padding: 8px 12px 8px 36px;\n  font-size: 13px;\n}\n.search::placeholder { color: var(--fg-subtle); }\n.search-wrap { position: relative; margin-bottom: 16px; min-width: 0; }\n.search-wrap svg {\n  position: absolute;\n  left: 12px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 16px;\n  height: 16px;\n  color: var(--fg-subtle);\n  pointer-events: none;\n}\n\n.group {\n  overflow: hidden;\n  margin-bottom: 16px;\n  min-width: 0;\n}\n.group-head {\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  align-items: center;\n  padding: 16px 20px;\n  background: transparent;\n  border: 0;\n  color: inherit;\n  text-align: left;\n}\n.group-head:hover { background: color-mix(in oklab, var(--bg-subtle) 40%, transparent); }\n.group-head h2 { margin: 0; font-size: 14px; font-weight: 600; }\n.group-head p { margin: 2px 0 0; font-size: 12px; color: var(--fg-muted); }\n.group-body {\n  border-top: 1px solid var(--border);\n  padding: 16px 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.group.collapsed .group-body { display: none; }\n.chev { transition: transform 200ms; color: var(--fg-muted); }\n.group:not(.collapsed) .chev { transform: rotate(180deg); }\n\n.field {\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: 12px 16px;\n  min-width: 0;\n  transition: background 150ms, opacity 150ms;\n}\n.field.on { background: var(--bg-elevated); }\n.field.off { background: color-mix(in oklab, var(--bg) 40%, transparent); opacity: 0.85; }\n.field-row { display: flex; gap: 12px; align-items: flex-start; min-width: 0; }\n.field-main { min-width: 0; flex: 1; }\n.field-title { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }\n.field-title span { font-size: 13px; font-weight: 500; }\n.field-title code {\n  font-size: 11px;\n  color: var(--fg-subtle);\n  word-break: break-all;\n}\n.field p { margin: 6px 0 0; font-size: 12px; color: var(--fg-muted); }\n.field-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }\n.field-meta code {\n  font-size: 11px;\n  color: var(--fg-subtle);\n  background: var(--bg-subtle);\n  border-radius: var(--radius-xs);\n  padding: 2px 6px;\n  word-break: break-all;\n}\n.field-controls { margin-top: 10px; min-width: 0; }\n.field-controls input[type=\"text\"],\n.field-controls input[type=\"number\"],\n.field-controls select {\n  width: 100%;\n  max-width: 28rem;\n  min-height: 40px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border);\n  background: var(--bg-subtle);\n  color: var(--fg);\n  padding: 8px 12px;\n  font-size: 13px;\n}\n\n.switch {\n  position: relative;\n  width: 44px;\n  height: 24px;\n  flex-shrink: 0;\n  margin-top: 2px;\n}\n.switch input { opacity: 0; width: 0; height: 0; position: absolute; }\n.switch .track {\n  position: absolute;\n  inset: 0;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-subtle);\n  transition: background 150ms;\n}\n.switch input:checked + .track { background: var(--accent); }\n.switch .thumb {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 18px;\n  height: 18px;\n  border-radius: 999px;\n  background: var(--fg-muted);\n  transition: transform 150ms, background 150ms;\n}\n.switch input:checked + .track .thumb {\n  transform: translateX(20px);\n  background: var(--accent-fg);\n}\n\n.preview-grid {\n  display: grid;\n  gap: 16px;\n  min-width: 0;\n}\n@media (min-width: 1024px) {\n  .preview-grid { grid-template-columns: 1fr 1fr; }\n}\n.preview-panel {\n  display: flex;\n  flex-direction: column;\n  min-height: 320px;\n  min-width: 0;\n  overflow: hidden;\n}\n.preview-panel header {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 8px;\n  align-items: center;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border);\n  background: transparent;\n}\n.preview-panel header strong { font-size: 13px; }\n.preview-panel header p { margin: 0; font-size: 11px; color: var(--fg-muted); }\n.preview-panel pre {\n  flex: 1;\n  margin: 0;\n  padding: 16px;\n  overflow: auto;\n  background: var(--bg);\n  color: var(--fg-muted);\n  font-size: 12px;\n  line-height: 1.6;\n  white-space: pre-wrap;\n  word-break: break-all;\n  scrollbar-width: thin;\n}\n\n.ref-article { padding: 16px; min-width: 0; }\n@media (min-width: 640px) { .ref-article { padding: 32px; } }\n.ref-article h2 { margin: 0 0 12px; font-size: 16px; font-weight: 600; }\n.ref-article section { margin-bottom: 32px; }\n.ref-article pre {\n  overflow-x: auto;\n  background: var(--bg);\n  border-radius: var(--radius-md);\n  padding: 16px;\n  font-size: 13px;\n  color: var(--fg-muted);\n}\n.ref-article table {\n  width: 100%;\n  min-width: 480px;\n  border-collapse: collapse;\n  font-size: 13px;\n  text-align: left;\n}\n.ref-article th {\n  padding: 8px 16px 8px 0;\n  font-weight: 500;\n  color: var(--fg-muted);\n  border-bottom: 1px solid var(--border);\n}\n.ref-article td {\n  padding: 8px 16px 8px 0;\n  color: var(--fg-muted);\n  border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);\n  vertical-align: top;\n}\n.table-scroll { overflow-x: auto; }\n\nfooter.app {\n  border-top: 1px solid var(--border);\n  padding: 32px 16px;\n  text-align: center;\n  font-size: 11px;\n  color: var(--fg-subtle);\n}\n\n.sticky-bar {\n  position: sticky;\n  bottom: 16px;\n  z-index: 30;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 12px;\n  border-radius: var(--radius-xl);\n  border: 1px solid var(--border);\n  background: color-mix(in oklab, var(--bg-elevated) 95%, transparent);\n  box-shadow: var(--shadow);\n  backdrop-filter: blur(8px);\n}\n@media (min-width: 1024px) { .sticky-bar { display: none; } }\n.sticky-bar .btn { flex: 1; min-height: 44px; }\n\n.hidden { display: none !important; }\n.ml-auto { margin-left: auto; }\n@media (max-width: 639px) {\n  .hide-sm { display: none !important; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n\n</style>\n</head>\n<body data-product=\"opencode\">\n<div id=\"app\"><div class=\"wrap\" style=\"padding:48px;color:var(--fg-muted)\">Loading…</div></div>\n<script>\n\nwindow.__STATIC_SCHEMA__ = {\"cliFlags\":[{\"category\":\"Session\",\"description\":\"Start TUI\",\"flag\":\"opencode\"},{\"category\":\"Session\",\"description\":\"Headless run\",\"flag\":\"opencode run \\\"<prompt>\\\"\"},{\"category\":\"Server\",\"description\":\"Headless API server\",\"flag\":\"opencode serve\"},{\"category\":\"Server\",\"description\":\"Server + web UI\",\"flag\":\"opencode web\"},{\"category\":\"Global\",\"description\":\"No external plugins\",\"flag\":\"--pure\"},{\"category\":\"Global\",\"description\":\"DEBUG|INFO|WARN|ERROR\",\"flag\":\"--log-level <LEVEL>\"},{\"category\":\"Global\",\"description\":\"Logs to stderr\",\"flag\":\"--print-logs\"},{\"category\":\"MCP\",\"description\":\"MCP management\",\"flag\":\"opencode mcp add|list|auth\"},{\"category\":\"Models\",\"description\":\"List models\",\"flag\":\"opencode models\"},{\"category\":\"Agents\",\"description\":\"Agents\",\"flag\":\"opencode agent create|list\"}],\"configPath\":\"~/.config/opencode/opencode.json\",\"envVars\":[{\"category\":\"Paths\",\"description\":\"Path to config file\",\"name\":\"OPENCODE_CONFIG\"},{\"category\":\"Paths\",\"description\":\"Config directory\",\"name\":\"OPENCODE_CONFIG_DIR\"},{\"category\":\"Paths\",\"description\":\"Inline JSON overrides\",\"name\":\"OPENCODE_CONFIG_CONTENT\"},{\"category\":\"UX\",\"description\":\"Disable update checks\",\"name\":\"OPENCODE_DISABLE_AUTOUPDATE\"},{\"category\":\"Context\",\"description\":\"Disable auto compact\",\"name\":\"OPENCODE_DISABLE_AUTOCOMPACT\"},{\"category\":\"Experimental\",\"description\":\"Umbrella experimental flag\",\"name\":\"OPENCODE_EXPERIMENTAL\"},{\"category\":\"Experimental\",\"description\":\"Plan mode\",\"name\":\"OPENCODE_EXPERIMENTAL_PLAN_MODE\"},{\"category\":\"Experimental\",\"description\":\"Background subagents\",\"name\":\"OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS\"},{\"category\":\"Experimental\",\"description\":\"Scout subagent\",\"name\":\"OPENCODE_EXPERIMENTAL_SCOUT\"},{\"category\":\"Server\",\"description\":\"Basic auth for serve/web\",\"name\":\"OPENCODE_SERVER_PASSWORD\"}],\"fields\":[{\"default\":\"anthropic/claude-sonnet-4-6\",\"description\":\"provider/model id, e.g. anthropic/claude-sonnet-4-6 or openai/gpt-5.4.\",\"group\":\"models\",\"id\":\"model\",\"label\":\"Primary model\",\"path\":\"model\",\"recommended\":true,\"section\":\"\",\"type\":\"string\"},{\"default\":\"anthropic/claude-haiku-4-5\",\"description\":\"Cheap model for titles / light tasks.\",\"group\":\"models\",\"id\":\"small_model\",\"label\":\"Small model\",\"path\":\"small_model\",\"recommended\":true,\"section\":\"\",\"type\":\"string\"},{\"default\":[\"anthropic\",\"openai\",\"openrouter\"],\"description\":\"Comma-separated allow-list of provider ids.\",\"group\":\"models\",\"id\":\"enabled_providers\",\"label\":\"Enabled providers\",\"path\":\"enabled_providers\",\"section\":\"\",\"type\":\"string-list\"},{\"description\":\"Comma-separated deny-list.\",\"group\":\"models\",\"id\":\"disabled_providers\",\"label\":\"Disabled providers\",\"path\":\"disabled_providers\",\"section\":\"\",\"type\":\"string-list\"},{\"default\":\"build\",\"description\":\"build | plan | or custom agent id.\",\"group\":\"agents\",\"id\":\"default_agent\",\"label\":\"Default agent\",\"path\":\"default_agent\",\"recommended\":true,\"section\":\"\",\"type\":\"string\"},{\"default\":2.0,\"description\":\"Max nesting (0 disables).\",\"group\":\"agents\",\"id\":\"subagent_depth\",\"label\":\"Subagent depth\",\"path\":\"subagent_depth\",\"recommended\":true,\"section\":\"\",\"type\":\"number\"},{\"default\":true,\"description\":\"Allow write tool.\",\"group\":\"tools\",\"id\":\"tools.write\",\"label\":\"Write tool\",\"path\":\"tools.write\",\"section\":\"tools\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Allow bash tool.\",\"group\":\"tools\",\"id\":\"tools.bash\",\"label\":\"Bash tool\",\"path\":\"tools.bash\",\"section\":\"tools\",\"type\":\"boolean\"},{\"default\":\"allow\",\"description\":\"allow | ask | deny for edits.\",\"group\":\"tools\",\"id\":\"edit\",\"label\":\"Edit permission\",\"options\":[\"allow\",\"ask\",\"deny\"],\"path\":\"edit\",\"recommended\":true,\"section\":\"\",\"type\":\"enum\"},{\"default\":\"ask\",\"description\":\"allow | ask | deny for bash.\",\"env\":\"OPENCODE_PERMISSION\",\"group\":\"tools\",\"id\":\"bash\",\"label\":\"Bash permission\",\"options\":[\"allow\",\"ask\",\"deny\"],\"path\":\"bash\",\"recommended\":true,\"section\":\"\",\"type\":\"enum\"},{\"default\":true,\"description\":\"Automatically compact long contexts.\",\"env\":\"OPENCODE_DISABLE_AUTOCOMPACT\",\"group\":\"compaction\",\"id\":\"compaction.auto\",\"label\":\"Auto compact\",\"path\":\"compaction.auto\",\"recommended\":true,\"section\":\"compaction\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Prune old turns when compacting.\",\"group\":\"compaction\",\"id\":\"compaction.prune\",\"label\":\"Prune on compact\",\"path\":\"compaction.prune\",\"section\":\"compaction\",\"type\":\"boolean\"},{\"default\":12000.0,\"description\":\"Token buffer reserved during compact.\",\"group\":\"compaction\",\"id\":\"compaction.reserved\",\"label\":\"Reserved tokens\",\"path\":\"compaction.reserved\",\"section\":\"compaction\",\"type\":\"number\"},{\"default\":4096.0,\"description\":\"Port for opencode serve / web.\",\"group\":\"server\",\"id\":\"server.port\",\"label\":\"Server port\",\"path\":\"server.port\",\"section\":\"server\",\"type\":\"number\"},{\"default\":\"127.0.0.1\",\"description\":\"Bind host.\",\"group\":\"server\",\"id\":\"server.hostname\",\"label\":\"Server hostname\",\"path\":\"server.hostname\",\"section\":\"server\",\"type\":\"string\"},{\"default\":false,\"description\":\"Advertise via mDNS.\",\"group\":\"server\",\"id\":\"server.mdns\",\"label\":\"mDNS\",\"path\":\"server.mdns\",\"section\":\"server\",\"type\":\"boolean\"},{\"default\":\"system\",\"description\":\"TUI theme (system or named).\",\"group\":\"ux\",\"id\":\"theme\",\"label\":\"Theme\",\"path\":\"theme\",\"section\":\"\",\"type\":\"string\"},{\"default\":\"manual\",\"description\":\"manual | auto | disabled.\",\"env\":\"OPENCODE_AUTO_SHARE\",\"group\":\"ux\",\"id\":\"share\",\"label\":\"Share mode\",\"options\":[\"manual\",\"auto\",\"disabled\"],\"path\":\"share\",\"section\":\"\",\"type\":\"enum\"},{\"default\":\"notify\",\"description\":\"true | false | notify.\",\"env\":\"OPENCODE_DISABLE_AUTOUPDATE\",\"group\":\"ux\",\"id\":\"autoupdate\",\"label\":\"Autoupdate\",\"options\":[\"true\",\"false\",\"notify\"],\"path\":\"autoupdate\",\"section\":\"\",\"type\":\"enum\"},{\"default\":true,\"description\":\"Track file changes during session.\",\"group\":\"ux\",\"id\":\"snapshot\",\"label\":\"Snapshot tracking\",\"path\":\"snapshot\",\"section\":\"\",\"type\":\"boolean\"},{\"description\":\"Shell binary for tools (empty = auto).\",\"group\":\"ux\",\"id\":\"shell\",\"label\":\"Shell\",\"path\":\"shell\",\"section\":\"\",\"type\":\"string\"},{\"default\":\"titanium\",\"description\":\"Display name in TUI.\",\"group\":\"ux\",\"id\":\"username\",\"label\":\"Username\",\"path\":\"username\",\"section\":\"\",\"type\":\"string\"},{\"default\":true,\"description\":\"Enable experimental plan mode.\",\"env\":\"OPENCODE_EXPERIMENTAL_PLAN_MODE\",\"group\":\"experimental\",\"id\":\"experimental.plan_mode\",\"label\":\"Plan mode\",\"path\":\"experimental.plan_mode\",\"recommended\":true,\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Run subagents in background.\",\"env\":\"OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS\",\"group\":\"experimental\",\"id\":\"experimental.background_subagents\",\"label\":\"Background subagents\",\"path\":\"experimental.background_subagents\",\"recommended\":true,\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Enable Scout research subagent.\",\"env\":\"OPENCODE_EXPERIMENTAL_SCOUT\",\"group\":\"experimental\",\"id\":\"experimental.scout\",\"label\":\"Scout subagent\",\"path\":\"experimental.scout\",\"recommended\":true,\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Enable workspace support.\",\"env\":\"OPENCODE_EXPERIMENTAL_WORKSPACES\",\"group\":\"experimental\",\"id\":\"experimental.workspaces\",\"label\":\"Workspaces\",\"path\":\"experimental.workspaces\",\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Experimental hooks system.\",\"group\":\"experimental\",\"id\":\"experimental.hooks\",\"label\":\"Hooks\",\"path\":\"experimental.hooks\",\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Expose LSP as a tool.\",\"env\":\"OPENCODE_EXPERIMENTAL_LSP_TOOL\",\"group\":\"experimental\",\"id\":\"experimental.lsp_tool\",\"label\":\"LSP tool\",\"path\":\"experimental.lsp_tool\",\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Parallel web search execution.\",\"env\":\"OPENCODE_EXPERIMENTAL_PARALLEL\",\"group\":\"experimental\",\"id\":\"experimental.parallel\",\"label\":\"Parallel search\",\"path\":\"experimental.parallel\",\"section\":\"experimental\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Enable language servers.\",\"env\":\"OPENCODE_DISABLE_LSP_DOWNLOAD\",\"group\":\"lsp\",\"id\":\"lsp\",\"label\":\"LSP enabled\",\"path\":\"lsp\",\"recommended\":true,\"section\":\"\",\"type\":\"boolean\"},{\"default\":true,\"description\":\"Enable code formatters.\",\"group\":\"lsp\",\"id\":\"formatter\",\"label\":\"Formatters enabled\",\"path\":\"formatter\",\"section\":\"\",\"type\":\"boolean\"},{\"default\":false,\"description\":\"Include a sample remote MCP entry.\",\"group\":\"mcp\",\"id\":\"mcp.demo.enabled\",\"label\":\"Demo MCP enabled\",\"path\":\"mcp.demo.enabled\",\"section\":\"mcp\",\"type\":\"boolean\"},{\"default\":\"https://mcp.example.com/sse\",\"description\":\"Remote MCP server URL.\",\"group\":\"mcp\",\"id\":\"mcp.demo.url\",\"label\":\"Demo MCP URL\",\"path\":\"mcp.demo.url\",\"section\":\"mcp\",\"type\":\"string\"}],\"format\":\"json\",\"groups\":[{\"description\":\"Primary + small models and provider allowlists.\",\"id\":\"models\",\"title\":\"Models\"},{\"description\":\"Default agent, depth, plan mode.\",\"id\":\"agents\",\"title\":\"Agents\"},{\"description\":\"write/bash/edit gates and tool toggles.\",\"id\":\"tools\",\"title\":\"Tools & permissions\"},{\"description\":\"Context auto-compact settings.\",\"id\":\"compaction\",\"title\":\"Compaction\"},{\"description\":\"opencode serve / web.\",\"id\":\"server\",\"title\":\"Server\"},{\"description\":\"Theme, share, autoupdate, snapshot, shell.\",\"id\":\"ux\",\"title\":\"UX\"},{\"description\":\"Plan mode, background subagents, scout, workspaces.\",\"id\":\"experimental\",\"title\":\"Experimental\"},{\"description\":\"Language intelligence and format-on-write.\",\"id\":\"lsp\",\"title\":\"LSP & formatters\"},{\"description\":\"Optional remote MCP server stub.\",\"id\":\"mcp\",\"title\":\"MCP sample\"}],\"presets\":[{\"description\":\"Wild-but-sane: Sonnet primary, Haiku small, plan mode, scout, background subagents, ask-before-bash, depth 2.\",\"enabled\":[\"model\",\"small_model\",\"enabled_providers\",\"default_agent\",\"subagent_depth\",\"tools.write\",\"tools.bash\",\"edit\",\"bash\",\"compaction.auto\",\"compaction.prune\",\"compaction.reserved\",\"theme\",\"share\",\"autoupdate\",\"snapshot\",\"username\",\"experimental.plan_mode\",\"experimental.background_subagents\",\"experimental.scout\",\"experimental.workspaces\",\"experimental.hooks\",\"experimental.lsp_tool\",\"experimental.parallel\",\"lsp\",\"formatter\"],\"id\":\"titanium\",\"name\":\"Titanium (default)\",\"values\":{\"autoupdate\":\"notify\",\"bash\":\"ask\",\"compaction.auto\":true,\"compaction.prune\":true,\"compaction.reserved\":12000,\"default_agent\":\"build\",\"edit\":\"allow\",\"enabled_providers\":[\"anthropic\",\"openai\",\"openrouter\"],\"experimental.background_subagents\":true,\"experimental.hooks\":true,\"experimental.lsp_tool\":true,\"experimental.parallel\":true,\"experimental.plan_mode\":true,\"experimental.scout\":true,\"experimental.workspaces\":true,\"formatter\":true,\"lsp\":true,\"model\":\"anthropic/claude-sonnet-4-6\",\"share\":\"manual\",\"small_model\":\"anthropic/claude-haiku-4-5\",\"snapshot\":true,\"subagent_depth\":2,\"theme\":\"system\",\"tools.bash\":true,\"tools.write\":true,\"username\":\"titanium\"}},{\"description\":\"Everything on: deeper subagents, auto-share off, server bind, demo MCP stub, parallel + scout.\",\"enabled\":[\"model\",\"small_model\",\"default_agent\",\"subagent_depth\",\"tools.write\",\"tools.bash\",\"edit\",\"bash\",\"compaction.auto\",\"server.port\",\"server.hostname\",\"experimental.plan_mode\",\"experimental.background_subagents\",\"experimental.scout\",\"experimental.workspaces\",\"experimental.hooks\",\"experimental.lsp_tool\",\"experimental.parallel\",\"lsp\",\"formatter\",\"mcp.demo.enabled\",\"mcp.demo.url\",\"username\",\"share\"],\"id\":\"titanium-max\",\"name\":\"Titanium Max\",\"values\":{\"bash\":\"allow\",\"compaction.auto\":true,\"default_agent\":\"build\",\"edit\":\"allow\",\"experimental.background_subagents\":true,\"experimental.hooks\":true,\"experimental.lsp_tool\":true,\"experimental.parallel\":true,\"experimental.plan_mode\":true,\"experimental.scout\":true,\"experimental.workspaces\":true,\"formatter\":true,\"lsp\":true,\"mcp.demo.enabled\":false,\"mcp.demo.url\":\"https://mcp.example.com/sse\",\"model\":\"anthropic/claude-opus-4-5\",\"server.hostname\":\"127.0.0.1\",\"server.port\":4096,\"share\":\"disabled\",\"small_model\":\"anthropic/claude-haiku-4-5\",\"subagent_depth\":3,\"tools.bash\":true,\"tools.write\":true,\"username\":\"titanium-max\"}},{\"description\":\"Ask on edit+bash, no background agents, shallow depth.\",\"enabled\":[\"model\",\"small_model\",\"edit\",\"bash\",\"tools.write\",\"tools.bash\",\"subagent_depth\",\"experimental.plan_mode\",\"share\"],\"id\":\"safe-pair\",\"name\":\"Safe pair-programming\",\"values\":{\"bash\":\"ask\",\"edit\":\"ask\",\"experimental.plan_mode\":true,\"model\":\"anthropic/claude-sonnet-4-6\",\"share\":\"disabled\",\"small_model\":\"anthropic/claude-haiku-4-5\",\"subagent_depth\":1,\"tools.bash\":true,\"tools.write\":true}},{\"description\":\"Route primary model through OpenAI gpt-5.4 while keeping Titanium UX.\",\"enabled\":[\"model\",\"small_model\",\"enabled_providers\",\"default_agent\",\"subagent_depth\",\"edit\",\"bash\",\"experimental.plan_mode\",\"lsp\"],\"id\":\"openai-codex-bridge\",\"name\":\"OpenAI bridge\",\"values\":{\"bash\":\"ask\",\"default_agent\":\"build\",\"edit\":\"allow\",\"enabled_providers\":[\"openai\"],\"experimental.plan_mode\":true,\"lsp\":true,\"model\":\"openai/gpt-5.4\",\"small_model\":\"openai/gpt-5-mini\",\"subagent_depth\":2}}],\"product\":\"opencode\",\"productTagline\":\"Titanium-grade OpenCode build — agents, MCP, plan mode, subagents, and sharp defaults.\",\"productTitle\":\"OpenCode Titanium\",\"subcommands\":[{\"cmd\":\"opencode\",\"desc\":\"Interactive TUI\"},{\"cmd\":\"opencode run\",\"desc\":\"Non-interactive prompt\"},{\"cmd\":\"opencode serve\",\"desc\":\"Headless server\"},{\"cmd\":\"opencode web\",\"desc\":\"Web UI server\"},{\"cmd\":\"opencode mcp\",\"desc\":\"MCP servers\"},{\"cmd\":\"opencode models\",\"desc\":\"List models\"},{\"cmd\":\"opencode agent\",\"desc\":\"Manage agents\"},{\"cmd\":\"opencode session\",\"desc\":\"Sessions\"},{\"cmd\":\"opencode upgrade\",\"desc\":\"Self-update\"}],\"versionNote\":\"OpenCode · Titanium build · opencode.json · pure Rust builder\"};\nwindow.__STATIC_PRODUCT__ = \"opencode\";\n\n(() => {\n  const PRODUCT = window.__STATIC_PRODUCT__ || \"grok\";\n  const state = {\n    schema: null,\n    enabled: new Set(),\n    values: {},\n    tab: \"builder\",\n    query: \"\",\n    activeGroup: \"all\",\n    collapsed: new Set(),\n    product: PRODUCT,\n  };\n  const $ = (s, el = document) => el.querySelector(s);\n  const $$ = (s, el = document) => [...el.querySelectorAll(s)];\n  const esc = (s) => {\n    const e = (n) => String.fromCharCode(38) + n + \";\";\n    return String(s)\n      .replace(/&/g, e(\"amp\"))\n      .replace(/</g, e(\"lt\"))\n      .replace(/>/g, e(\"gt\"))\n      .replace(/\"/g, e(\"quot\"));\n  };\n  const toast = (msg) => {\n    let t = $(\"#toast\");\n    if (!t) {\n      t = document.createElement(\"div\");\n      t.id = \"toast\";\n      Object.assign(t.style, {\n        position: \"fixed\", bottom: \"24px\", right: \"24px\", zIndex: \"100\",\n        padding: \"10px 14px\", borderRadius: \"8px\", background: \"#1a1a1e\",\n        color: \"#f4f4f5\", fontSize: \"13px\", fontFamily: \"inherit\",\n      });\n      document.body.appendChild(t);\n    }\n    t.textContent = msg;\n    t.style.opacity = \"1\";\n    clearTimeout(t._tm);\n    t._tm = setTimeout(() => { t.style.opacity = \"0\"; }, 1400);\n  };\n  const dl = (name, content, mime) => {\n    const b = new Blob([content], { type: mime });\n    const u = URL.createObjectURL(b);\n    const a = document.createElement(\"a\");\n    a.href = u; a.download = name; a.click();\n    URL.revokeObjectURL(u);\n  };\n  function defaults() {\n    const v = {};\n    for (const f of state.schema.fields) if (f.default != null) v[f.id] = f.default;\n    const p = state.schema.presets && state.schema.presets[0];\n    if (p && p.values) Object.assign(v, p.values);\n    return v;\n  }\n  async function gen() {\n    return clientGenerate(state.schema, [...state.enabled], state.values);\n  }\n  function clientGenerate(schema, enabled, values) {\n    const en = new Set(enabled);\n    const fmt = schema.format || \"toml\";\n    if (fmt === \"json\") {\n      const root = { \"$schema\": \"https://opencode.ai/config.json\", \"_comment\": \"OpenCode Titanium\" };\n      for (const f of schema.fields) {\n        if (!en.has(f.id) || values[f.id] == null || values[f.id] === \"\") continue;\n        const parts = f.path.split(\".\");\n        let cur = root;\n        for (let i = 0; i < parts.length - 1; i++) {\n          cur[parts[i]] = cur[parts[i]] || {};\n          cur = cur[parts[i]];\n        }\n        let v = values[f.id];\n        if (f.type === \"string-list\" && typeof v === \"string\") v = v.split(\",\").map(s=>s.trim()).filter(Boolean);\n        if (f.id === \"autoupdate\") { if (v === \"true\") v = true; else if (v === \"false\") v = false; }\n        cur[parts[parts.length-1]] = v;\n      }\n      if (en.has(\"default_agent\")) {\n        root.agent = {\n          build: { description: \"Titanium build\", prompt: \"Ship working code.\" },\n          plan: { description: \"Titanium plan\", prompt: \"Plan before edits.\" },\n          scout: { description: \"Scout\", prompt: \"Research and report.\" }\n        };\n      }\n      const config = JSON.stringify(root, null, 2);\n      return { config, toml: config, env: \"# OpenCode Titanium\\nexport OPENCODE_EXPERIMENTAL=1\\n\", cli: \"opencode\\n\", markdown: \"# OpenCode Titanium\\n\" };\n    }\n    // TOML (codex/grok-ish)\n    const lines = [];\n    const sections = {};\n    for (const f of schema.fields) {\n      if (!en.has(f.id) || values[f.id] == null || values[f.id] === \"\") continue;\n      let formatted;\n      const v = values[f.id];\n      if (f.type === \"boolean\") formatted = v ? \"true\" : \"false\";\n      else if (f.type === \"number\") formatted = String(v);\n      else if (f.type === \"string-list\") {\n        const list = Array.isArray(v) ? v : String(v).split(\",\").map(s=>s.trim()).filter(Boolean);\n        if (!list.length) continue;\n        formatted = \"[\" + list.map(s => JSON.stringify(s)).join(\", \") + \"]\";\n      } else formatted = JSON.stringify(String(v));\n      if (f.section) {\n        (sections[f.section] ||= []).push((f.path.split(\".\").pop()) + \" = \" + formatted);\n      } else if (f.id.startsWith(\"provider.\") && f.id !== \"provider.id\") {\n        const pid = values[\"provider.id\"] || \"custom\";\n        (sections[\"model_providers.\" + pid] ||= []).push(f.id.replace(\"provider.\", \"\") + \" = \" + formatted);\n      } else if (f.id !== \"provider.id\") {\n        lines.push(f.path + \" = \" + formatted);\n      }\n    }\n    let out = \"# Generated Titanium config\\n\\n\" + lines.join(\"\\n\") + \"\\n\\n\";\n    for (const [sec, ls] of Object.entries(sections)) {\n      out += \"[\" + sec + \"]\\n\" + ls.join(\"\\n\") + \"\\n\\n\";\n    }\n    if ((schema.product || \"\") === \"codex\") {\n      out += \"[profiles.titanium]\\n# codex --profile titanium\\n\";\n      if (en.has(\"model\") && values.model) out += \"model = \" + JSON.stringify(String(values.model)) + \"\\n\";\n    }\n    return { config: out, toml: out, env: \"# env\\n\", cli: (schema.product === \"codex\" ? \"codex --profile titanium\\n\" : \"opencode\\n\"), markdown: \"# \" + (schema.productTitle||\"Config\") + \"\\n\" };\n  }\n  function sw(on) {\n    return `<label class=\"switch\"><input type=\"checkbox\"${on ? \" checked\" : \"\"} /><span class=\"track\"><span class=\"thumb\"></span></span></label>`;\n  }\n  function fieldHtml(f) {\n    const on = state.enabled.has(f.id);\n    const val = state.values[f.id];\n    let c = \"\";\n    if (on) {\n      if (f.type === \"boolean\") {\n        c = `<div class=\"field-controls row\">${sw(!!val)}<span style=\"font-size:13px;color:var(--fg-muted)\">${val ? \"true\" : \"false\"}</span></div>`;\n      } else if (f.type === \"enum\" && f.options) {\n        const cur = String(val ?? f.default ?? f.options[0]);\n        c = `<div class=\"field-controls\"><select data-field=\"${f.id}\">${f.options.map((o) => `<option value=\"${esc(o)}\"${cur === o ? \" selected\" : \"\"}>${esc(o)}</option>`).join(\"\")}</select></div>`;\n      } else if (f.type === \"string-list\") {\n        const v = Array.isArray(val) ? val.join(\", \") : val ?? \"\";\n        c = `<div class=\"field-controls\"><input type=\"text\" data-field=\"${f.id}\" data-list=\"1\" value=\"${esc(String(v))}\" /></div>`;\n      } else {\n        const t = f.type === \"number\" ? \"number\" : \"text\";\n        c = `<div class=\"field-controls\"><input type=\"${t}\" data-field=\"${f.id}\" value=\"${esc(val == null ? \"\" : String(val))}\" /></div>`;\n      }\n    }\n    return `<div class=\"field ${on ? \"on\" : \"off\"}\" data-id=\"${f.id}\"><div class=\"field-row\">${sw(on)}<div class=\"field-main\"><div class=\"field-title\"><span>${esc(f.label)}</span>${f.recommended ? `<span class=\"badge success\">recommended</span>` : \"\"}<code>${esc(f.path)}</code></div><p>${esc(f.description)}</p>${f.env || f.cli ? `<div class=\"field-meta\">${f.env ? `<code>env ${esc(f.env)}</code>` : \"\"}${f.cli ? `<code>cli ${esc(f.cli)}</code>` : \"\"}</div>` : \"\"}${c}</div></div></div>`;\n  }\n  function groupsFiltered() {\n    const q = state.query.trim().toLowerCase();\n    return state.schema.groups.map((g) => {\n      let fields = state.schema.fields.filter((f) => f.group === g.id);\n      if (state.activeGroup !== \"all\" && g.id !== state.activeGroup) fields = [];\n      if (q) fields = fields.filter((f) => [f.label, f.path, f.description, f.env || \"\"].join(\" \").toLowerCase().includes(q));\n      return { group: g, fields };\n    }).filter((x) => x.fields.length);\n  }\n  function builder() {\n    const groups = groupsFiltered();\n    const presets = state.schema.presets.map((p) => `<button type=\"button\" class=\"preset-btn\" data-preset=\"${p.id}\"><strong>${esc(p.name)}</strong><span>${esc(p.description)}</span></button>`).join(\"\");\n    const mpres = state.schema.presets.map((p) => `<button type=\"button\" class=\"btn sm pill\" data-preset=\"${p.id}\">${esc(p.name)}</button>`).join(\"\");\n    const secs = state.schema.groups.map((g) => `<button type=\"button\" class=\"btn ghost sm\" data-group=\"${g.id}\" style=\"width:100%;justify-content:flex-start;border-radius:8px\">${esc(g.title)}</button>`).join(\"\");\n    const body = groups.map(({ group, fields }) => {\n      const col = state.collapsed.has(group.id);\n      return `<section class=\"panel group ${col ? \"collapsed\" : \"\"}\"><button type=\"button\" class=\"group-head\" data-toggle-group=\"${group.id}\"><div><h2>${esc(group.title)}</h2><p>${esc(group.description)}</p></div><svg class=\"chev\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></button><div class=\"group-body\">${fields.map(fieldHtml).join(\"\")}</div></section>`;\n    }).join(\"\");\n    return `<div class=\"layout\"><div class=\"mobile-strip\"><div class=\"mobile-presets\">${mpres}</div><div class=\"row\" style=\"margin-top:12px\"><button type=\"button\" class=\"btn outline sm\" data-action=\"enable-all\">Include all</button><button type=\"button\" class=\"btn outline sm\" data-action=\"clear\">Clear</button><button type=\"button\" class=\"btn ghost sm\" data-action=\"reset\">Reset</button></div></div><aside class=\"sidebar\"><div class=\"panel\"><h3>Presets</h3>${presets}</div><div class=\"panel\"><h3>Bulk</h3><button type=\"button\" class=\"btn outline sm\" style=\"width:100%;margin-bottom:8px\" data-action=\"enable-all\">Include all</button><button type=\"button\" class=\"btn outline sm\" style=\"width:100%;margin-bottom:8px\" data-action=\"clear\">Clear all</button><button type=\"button\" class=\"btn ghost sm\" style=\"width:100%\" data-action=\"reset\">Reset defaults</button></div><div class=\"panel\"><h3>Sections</h3><button type=\"button\" class=\"btn ghost sm\" data-group=\"all\" style=\"width:100%;justify-content:flex-start;border-radius:8px\">All sections</button>${secs}</div></aside><div style=\"min-width:0\"><div class=\"search-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"search\" type=\"search\" placeholder=\"Search settings\" id=\"search\" value=\"${esc(state.query)}\" /></div>${groups.length ? body : `<div class=\"panel\" style=\"padding:32px;text-align:center;color:var(--fg-muted)\">No matches.</div>`}<div class=\"sticky-bar\"><button type=\"button\" class=\"btn\" data-action=\"download-toml\">Download patch</button><button type=\"button\" class=\"btn secondary\" data-action=\"tab-preview\">Preview</button></div></div></div>`;\n  }\n  async function preview() {\n    let g;\n    try { g = await gen(); } catch { return `<div class=\"panel\" style=\"padding:24px\">Generate failed</div>`; }\n    window.__gen = g;\n    const cfgName = state.schema.format === \"json\" ? \"opencode.json\" : \"config.toml\";\n    const path = state.schema.configPath || state.schema.config_path || \"\";\n    const p = (t, s, c) => `<div class=\"panel preview-panel\"><header><div><strong>${t}</strong><p>${s}</p></div><div class=\"row\"><button type=\"button\" class=\"btn outline sm\" data-copy=\"1\">Copy</button><button type=\"button\" class=\"btn sm\" data-dl=\"1\">Download</button></div></header><pre>${esc(c)}</pre></div>`;\n    return `<div class=\"preview-grid\">${p(cfgName, path, g.toml || g.config)}${p(\"env\", \"exports\", g.env)}${p(\"cli\", \"launch\", g.cli)}${p(\"markdown\", \"reference\", g.markdown)}</div>`;\n  }\n  function reference() {\n    const s = state.schema;\n    const flags = (s.cliFlags || []).map((f) => `<tr><td>${esc(f.flag)}</td><td>${esc(f.category)}</td><td>${esc(f.description)}</td></tr>`).join(\"\");\n    const envs = (s.envVars || []).map((e) => `<tr><td>${esc(e.name)}</td><td>${esc(e.category)}</td><td>${esc(e.description)}</td></tr>`).join(\"\");\n    const subs = (s.subcommands || []).map((c) => `<div class=\"panel\" style=\"padding:8px 12px;background:var(--bg)\"><code>${esc(c.cmd)}</code><p style=\"margin:4px 0 0;font-size:12px;color:var(--fg-muted)\">${esc(c.desc)}</p></div>`).join(\"\");\n    return `<div><div class=\"row\" style=\"justify-content:space-between;margin-bottom:16px\"><p style=\"margin:0;color:var(--fg-muted);font-size:13px\">Reference · ${esc(s.configPath || s.config_path || \"\")}</p><button type=\"button\" class=\"btn secondary sm\" data-action=\"download-md\">Download .md</button></div><article class=\"panel ref-article\"><section><h2>Subcommands</h2><div style=\"display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(220px,1fr))\">${subs}</div></section><section><h2>Flags</h2><div class=\"table-scroll\"><table><thead><tr><th>Flag</th><th>Cat</th><th>Desc</th></tr></thead><tbody>${flags}</tbody></table></div></section><section><h2>Env</h2><div class=\"table-scroll\"><table><thead><tr><th>Var</th><th>Cat</th><th>Desc</th></tr></thead><tbody>${envs}</tbody></table></div></section></article></div>`;\n  }\n  async function render() {\n    const root = $(\"#app\");\n    if (!root || !state.schema) return;\n    const n = state.enabled.size;\n    const title = state.schema.productTitle || state.schema.product_title || \"Config builder\";\n    const tag = state.schema.productTagline || state.schema.product_tagline || \"\";\n    const note = state.schema.versionNote || state.schema.version_note || \"pure Rust\";\n    const tab = (id, lab) => `<button type=\"button\" class=\"btn pill ${state.tab === id ? \"active\" : \"\"}\" data-tab=\"${id}\">${lab}</button>`;\n    let body = state.tab === \"builder\" ? builder() : state.tab === \"preview\" ? await preview() : reference();\n    root.innerHTML = `<header class=\"app\"><div class=\"wrap\"><div class=\"header-top\"><div style=\"min-width:0\"><div class=\"eyebrow\"><a href=\"/\" style=\"color:inherit;text-decoration:none\">← hub</a> · ${esc(title)} · Rust</div><h1>${esc(title)}</h1><p class=\"lede\">${esc(tag)} · JetBrainsMonoNL Nerd Font Mono</p></div><div class=\"row\"><button type=\"button\" class=\"btn secondary sm\" data-action=\"download-md\">Download .md</button><button type=\"button\" class=\"btn sm\" data-action=\"download-toml\">Download patch</button></div></div><div class=\"tabs\">${tab(\"builder\", \"Builder\")}${tab(\"preview\", \"Preview\")}${tab(\"reference\", \"Reference\")}<span class=\"badge hide-sm ml-auto\">${n} in patch</span></div></div></header><main class=\"wrap\">${body}</main><footer class=\"app\">${esc(note)} · JetBrainsMonoNL Nerd Font Mono</footer>`;\n    bind(root);\n  }\n  function bind(root) {\n    $$(\"[data-tab]\", root).forEach((el) => el.addEventListener(\"click\", () => { state.tab = el.getAttribute(\"data-tab\"); render(); }));\n    $$(\"[data-preset]\", root).forEach((el) => el.addEventListener(\"click\", () => {\n      const p = state.schema.presets.find((x) => x.id === el.getAttribute(\"data-preset\"));\n      if (!p) return;\n      state.enabled = new Set(p.enabled);\n      Object.assign(state.values, p.values);\n      toast(\"Applied: \" + p.name);\n      render();\n    }));\n    $$(\"[data-group]\", root).forEach((el) => el.addEventListener(\"click\", () => { state.activeGroup = el.getAttribute(\"data-group\"); render(); }));\n    $$(\"[data-toggle-group]\", root).forEach((el) => el.addEventListener(\"click\", () => {\n      const id = el.getAttribute(\"data-toggle-group\");\n      if (state.collapsed.has(id)) state.collapsed.delete(id); else state.collapsed.add(id);\n      render();\n    }));\n    $$(\"[data-action]\", root).forEach((el) => el.addEventListener(\"click\", async () => {\n      const a = el.getAttribute(\"data-action\");\n      if (a === \"enable-all\") { state.enabled = new Set(state.schema.fields.map((f) => f.id)); toast(\"All included\"); render(); }\n      else if (a === \"clear\") { state.enabled = new Set(); toast(\"Cleared\"); render(); }\n      else if (a === \"reset\") { state.enabled = new Set(state.schema.presets[0].enabled); state.values = defaults(); toast(\"Reset\"); render(); }\n      else if (a === \"tab-preview\") { state.tab = \"preview\"; render(); }\n      else if (a === \"download-toml\") {\n        const g = await gen();\n        const name = state.schema.format === \"json\" ? \"opencode.json\" : \"config.toml\";\n        const mime = state.schema.format === \"json\" ? \"application/json\" : \"application/toml\";\n        dl(name, g.toml || g.config, mime);\n      } else if (a === \"download-md\") {\n        const g = await gen();\n        dl(state.product + \"-config-reference.md\", g.markdown, \"text/markdown\");\n      }\n    }));\n    $$(\".field\", root).forEach((fieldEl) => {\n      const id = fieldEl.getAttribute(\"data-id\");\n      const switches = $$(\".switch input\", fieldEl);\n      if (!switches[0]) return;\n      switches[0].addEventListener(\"change\", () => {\n        if (switches[0].checked) state.enabled.add(id); else state.enabled.delete(id);\n        render();\n      });\n      if (switches[1]) switches[1].addEventListener(\"change\", () => { state.values[id] = switches[1].checked; render(); });\n    });\n    $$(\"input[data-field], select[data-field]\", root).forEach((el) => {\n      const apply = () => {\n        const id = el.getAttribute(\"data-field\");\n        if (el.getAttribute(\"data-list\") === \"1\") state.values[id] = el.value.split(\",\").map((x) => x.trim()).filter(Boolean);\n        else if (el.type === \"number\") state.values[id] = el.value === \"\" ? \"\" : Number(el.value);\n        else state.values[id] = el.value;\n      };\n      el.addEventListener(\"change\", apply);\n      el.addEventListener(\"input\", apply);\n    });\n    const search = $(\"#search\", root);\n    if (search) search.addEventListener(\"keydown\", (e) => { if (e.key === \"Enter\") { state.query = search.value; render(); } });\n    $$(\".preview-panel\", root).forEach((panel, i) => {\n      const keys = [\"toml\", \"env\", \"cli\", \"markdown\"];\n      const isJson = state.schema && state.schema.format === \"json\";\n      const files = [\n        [isJson ? \"opencode.json\" : \"config.toml\", isJson ? \"application/json\" : \"application/toml\"],\n        [\"env.sh\", \"text/plain\"],\n        [\"launch.sh\", \"text/plain\"],\n        [state.product + \"-config-reference.md\", \"text/markdown\"],\n      ];\n      let content = (window.__gen && window.__gen[keys[i]]) || \"\";\n      if (i === 0 && !content && window.__gen) content = window.__gen.config || \"\";\n      const btns = $$(\"button\", panel);\n      if (btns[0]) btns[0].addEventListener(\"click\", async () => { try { await navigator.clipboard.writeText(content); toast(\"Copied\"); } catch { toast(\"Copy failed\"); } });\n      if (btns[1]) btns[1].addEventListener(\"click\", () => dl(files[i][0], content, files[i][1]));\n    });\n  }\n  (async () => {\n    state.schema = window.__STATIC_SCHEMA__;\n    if (state.schema.cli_flags) state.schema.cliFlags = state.schema.cli_flags;\n    if (state.schema.env_vars) state.schema.envVars = state.schema.env_vars;\n    if (state.schema.cliFlags === undefined && state.schema.cli_flags) state.schema.cliFlags = state.schema.cli_flags;\n    // serde may already camelCase\n    state.enabled = new Set(state.schema.presets[0].enabled);\n    state.values = defaults();\n    await render();\n  })().catch((e) => {\n    document.getElementById(\"app\").textContent = String(e);\n  });\n})();\n\n</script>\n</body>\n</html>","encoding":"utf-8"},{"file":"vercel.json","data":"{\"cleanUrls\":true}","encoding":"utf-8"}]}