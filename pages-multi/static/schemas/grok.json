{
  "product": "grok",
  "productTitle": "Grok Build",
  "productTagline": "Grok Build CLI — titanium-clone unrestricted + agents wired",
  "configPath": "~/.grok/config.toml",
  "format": "toml",
  "versionNote": "Grok Build · titanium-clone unrestricted · agents/subagents wired",
  "cliFlags": [
    {"category": "Session", "description": "Working directory", "flag": "--cwd <PATH>"},
    {"category": "Model", "description": "Model ID", "flag": "-m, --model <MODEL>"},
    {"category": "Permissions", "description": "Auto-approve", "flag": "--always-approve / --yolo"},
    {"category": "Permissions", "description": "Sandbox", "flag": "--sandbox <PROFILE>"},
    {"category": "Agent", "description": "Disable subagents", "flag": "--no-subagents"},
    {"category": "Agent", "description": "Disable memory", "flag": "--no-memory"},
    {"category": "Agent", "description": "Max turns", "flag": "--max-turns <N>"},
    {"category": "Headless", "description": "One-shot", "flag": "-p, --single <PROMPT>"}
  ],
  "envVars": [
    {"category": "Paths", "description": "Home", "name": "GROK_HOME"},
    {"category": "Auth", "description": "API key", "name": "XAI_API_KEY"},
    {"category": "Models", "description": "Default model", "name": "GROK_DEFAULT_MODEL"},
    {"category": "Features", "description": "Subagents 1/0", "name": "GROK_SUBAGENTS"},
    {"category": "Features", "description": "Memory 1/0", "name": "GROK_MEMORY"},
    {"category": "Sandbox", "description": "Sandbox profile", "name": "GROK_SANDBOX"},
    {"category": "Agent", "description": "Agent name or path", "name": "GROK_AGENT"}
  ],
  "groups": [
    {"id": "models", "title": "Models", "description": "Default model and sampling"},
    {"id": "sandbox", "title": "Sandbox", "description": "FS sandbox"},
    {"id": "permissions", "title": "Permissions", "description": "Approval mode"},
    {"id": "features", "title": "Features", "description": "Memory, subagents, tools"},
    {"id": "agents", "title": "Agents & subagents", "description": "Agent profile and subagent concurrency/toggles"},
    {"id": "privacy", "title": "Privacy", "description": "Upload and telemetry"},
    {"id": "plugins", "title": "Plugins", "description": "Plugin paths and lists"},
    {"id": "ui", "title": "UI", "description": "Theme and layout"},
    {"id": "cli", "title": "CLI", "description": "Auto-update and tips"}
  ],
  "fields": [
    {"id": "models.default", "path": "models.default", "section": "models", "group": "models", "label": "Default model", "type": "string", "default": "grok-build", "recommended": true, "env": "GROK_DEFAULT_MODEL", "cli": "-m, --model", "description": "Session default model"},
    {"id": "models.default_reasoning_effort", "path": "models.default_reasoning_effort", "section": "models", "group": "models", "label": "Reasoning effort", "type": "enum", "options": ["low", "medium", "high"], "default": "high", "description": "Default effort"},
    {"id": "sandbox.profile", "path": "sandbox.profile", "section": "sandbox", "group": "sandbox", "label": "Sandbox profile", "type": "enum", "options": ["off", "workspace", "devbox", "read-only", "strict"], "default": "off", "recommended": true, "env": "GROK_SANDBOX", "cli": "--sandbox", "description": "Titanium-clone uses off"},
    {"id": "sandbox.auto_allow_bash", "path": "sandbox.auto_allow_bash", "section": "sandbox", "group": "sandbox", "label": "Auto-allow bash", "type": "boolean", "default": true, "description": "Skip bash prompts in sandbox"},
    {"id": "permissions.permission_mode", "path": "permissions.permission_mode", "section": "permissions", "group": "permissions", "label": "Permission mode", "type": "enum", "options": ["auto", "ask", "always-approve"], "default": "always-approve", "recommended": true, "cli": "--always-approve / --yolo", "description": "Titanium-clone uses always-approve"},
    {"id": "features.subagents", "path": "features.subagents", "section": "features", "group": "features", "label": "Subagents feature", "type": "boolean", "default": true, "recommended": true, "env": "GROK_SUBAGENTS", "cli": "--no-subagents", "description": "Enable task/subagent tool"},
    {"id": "features.memory", "path": "features.memory", "section": "features", "group": "features", "label": "Cross-session memory", "type": "boolean", "default": false, "env": "GROK_MEMORY", "description": "Clone of titanium memories=false"},
    {"id": "features.web_fetch", "path": "features.web_fetch", "section": "features", "group": "features", "label": "Web fetch", "type": "boolean", "default": false, "description": "web_fetch tool"},
    {"id": "features.write_file", "path": "features.write_file", "section": "features", "group": "features", "label": "Write file tool", "type": "boolean", "default": true, "description": "Write tool"},
    {"id": "features.tool_search", "path": "features.tool_search", "section": "features", "group": "features", "label": "Tool search", "type": "boolean", "default": true, "description": "MCP tool discovery"},
    {"id": "agent.name", "path": "name", "section": "agent", "group": "agents", "label": "Agent name", "type": "string", "default": "", "env": "GROK_AGENT", "description": "Discovered agent name from ~/.grok/agents or .grok/agents"},
    {"id": "agent.definition", "path": "definition", "section": "agent", "group": "agents", "label": "Agent definition path", "type": "string", "default": "", "description": "Explicit path to agent .md profile"},
    {"id": "subagents.enabled", "path": "enabled", "section": "subagents", "group": "agents", "label": "Subagents enabled", "type": "boolean", "default": true, "recommended": true, "description": "Master subagents toggle ([subagents] enabled)"},
    {"id": "subagents.max_concurrent", "path": "max_concurrent", "section": "subagents", "group": "agents", "label": "Max concurrent subagents", "type": "number", "default": 64, "recommended": true, "description": "Clone of titanium multi_agent_v2 max threads (64)"},
    {"id": "subagents.toggle.explore", "path": "explore", "section": "subagents.toggle", "group": "agents", "label": "Toggle explore subagent", "type": "boolean", "default": true, "description": "Enable explore subagent type"},
    {"id": "subagents.toggle.plan", "path": "plan", "section": "subagents.toggle", "group": "agents", "label": "Toggle plan subagent", "type": "boolean", "default": true, "description": "Enable plan subagent type"},
    {"id": "subagents.models.explore", "path": "explore", "section": "subagents.models", "group": "agents", "label": "Explore subagent model", "type": "string", "default": "", "description": "Optional model override for explore"},
    {"id": "subagents.models.plan", "path": "plan", "section": "subagents.models", "group": "agents", "label": "Plan subagent model", "type": "string", "default": "", "description": "Optional model override for plan"},
    {"id": "harness.disable_codebase_upload", "path": "harness.disable_codebase_upload", "section": "harness", "group": "privacy", "label": "Disable codebase upload", "type": "boolean", "default": true, "recommended": true, "description": "Skip repo upload"},
    {"id": "telemetry.trace_upload", "path": "telemetry.trace_upload", "section": "telemetry", "group": "privacy", "label": "Trace upload", "type": "boolean", "default": false, "description": "Telemetry traces"},
    {"id": "plugins.paths", "path": "plugins.paths", "section": "plugins", "group": "plugins", "label": "Plugin paths", "type": "string-list", "description": "Extra plugin dirs"},
    {"id": "plugins.enabled", "path": "plugins.enabled", "section": "plugins", "group": "plugins", "label": "Enabled plugins", "type": "string-list", "description": "Enable by name"},
    {"id": "cli.auto_update", "path": "cli.auto_update", "section": "cli", "group": "cli", "label": "Auto update", "type": "boolean", "default": true, "description": "Check updates on launch"},
    {"id": "ui.theme", "path": "ui.theme", "section": "ui", "group": "ui", "label": "Theme", "type": "string", "default": "auto", "description": "Color theme"},
    {"id": "ui.show_thinking_blocks", "path": "ui.show_thinking_blocks", "section": "ui", "group": "ui", "label": "Show thinking blocks", "type": "boolean", "default": true, "description": "Show reasoning in TUI"}
  ],
  "presets": [
    {
      "id": "titanium-clone",
      "name": "Titanium clone (unrestricted)",
      "description": "Clone of significant titanium unrestricted settings for Grok Build: always-approve, sandbox off, subagents on @64, memory off, agents wired",
      "enabled": ["models.default", "models.default_reasoning_effort", "sandbox.profile", "sandbox.auto_allow_bash", "permissions.permission_mode", "features.subagents", "features.memory", "features.write_file", "features.tool_search", "subagents.enabled", "subagents.max_concurrent", "subagents.toggle.explore", "subagents.toggle.plan", "agent.name", "harness.disable_codebase_upload", "telemetry.trace_upload", "ui.show_thinking_blocks"],
      "values": {
        "models.default": "grok-build",
        "models.default_reasoning_effort": "high",
        "sandbox.profile": "off",
        "sandbox.auto_allow_bash": true,
        "permissions.permission_mode": "always-approve",
        "features.subagents": true,
        "features.memory": false,
        "features.write_file": true,
        "features.tool_search": true,
        "subagents.enabled": true,
        "subagents.max_concurrent": 64,
        "subagents.toggle.explore": true,
        "subagents.toggle.plan": true,
        "agent.name": "",
        "harness.disable_codebase_upload": true,
        "telemetry.trace_upload": false,
        "ui.show_thinking_blocks": true
      }
    },
    {
      "id": "privacy-first",
      "name": "Privacy first",
      "description": "Disable uploads; workspace sandbox",
      "enabled": ["harness.disable_codebase_upload", "telemetry.trace_upload", "sandbox.profile", "models.default"],
      "values": {
        "harness.disable_codebase_upload": true,
        "telemetry.trace_upload": false,
        "sandbox.profile": "workspace",
        "models.default": "grok-build"
      }
    },
    {
      "id": "safe-dev",
      "name": "Safe development",
      "description": "Workspace sandbox, ask mode",
      "enabled": ["sandbox.profile", "permissions.permission_mode", "features.web_fetch", "features.write_file", "models.default"],
      "values": {
        "sandbox.profile": "workspace",
        "permissions.permission_mode": "ask",
        "features.web_fetch": false,
        "features.write_file": true,
        "models.default": "grok-build"
      }
    },
    {
      "id": "ci-headless",
      "name": "CI / headless",
      "description": "Always-approve, subagents on",
      "enabled": ["permissions.permission_mode", "cli.auto_update", "models.default", "features.subagents", "subagents.enabled", "sandbox.profile"],
      "values": {
        "permissions.permission_mode": "always-approve",
        "cli.auto_update": false,
        "models.default": "grok-build",
        "features.subagents": true,
        "subagents.enabled": true,
        "sandbox.profile": "workspace"
      }
    }
  ],
  "subcommands": [
    {"cmd": "grok login", "desc": "Sign in"},
    {"cmd": "grok logout", "desc": "Sign out"},
    {"cmd": "grok inspect", "desc": "Show config"},
    {"cmd": "grok models", "desc": "List models"},
    {"cmd": "grok sessions", "desc": "Manage sessions"},
    {"cmd": "grok update", "desc": "Update CLI"}
  ]
}
