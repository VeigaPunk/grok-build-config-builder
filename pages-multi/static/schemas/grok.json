{
  "cliFlags": [
    {
      "category": "Session",
      "description": "Set working directory",
      "flag": "--cwd <PATH>"
    },
    {
      "category": "Session",
      "description": "Resume session (omit ID = most recent)",
      "flag": "-r, --resume [<ID>]"
    },
    {
      "category": "Session",
      "description": "Continue most recent session for this directory",
      "flag": "-c, --continue"
    },
    {
      "category": "Session",
      "description": "Use a specific UUID for a new session",
      "flag": "-s, --session-id <UUID>"
    },
    {
      "category": "Session",
      "description": "When resuming, fork into a new session ID",
      "flag": "--fork-session"
    },
    {
      "category": "Session",
      "description": "Start session in a new git worktree",
      "flag": "-w, --worktree [<NAME>]"
    },
    {
      "category": "Session",
      "description": "Branch, tag, or commit for the worktree",
      "flag": "--ref <REF>"
    },
    {
      "category": "Model",
      "description": "Model ID",
      "flag": "-m, --model <MODEL>"
    },
    {
      "category": "Model",
      "description": "Reasoning effort level",
      "flag": "--effort <LEVEL>"
    },
    {
      "category": "Permissions",
      "description": "Auto-approve all tool executions",
      "flag": "--always-approve / --yolo"
    },
    {
      "category": "Permissions",
      "description": "Permission allow rule (e.g. 'Bash(git *)')",
      "flag": "--allow <RULE>"
    },
    {
      "category": "Permissions",
      "description": "Permission deny rule",
      "flag": "--deny <RULE>"
    },
    {
      "category": "Permissions",
      "description": "Sandbox profile: off | workspace | read-only | strict",
      "flag": "--sandbox <PROFILE>"
    },
    {
      "category": "Prompt",
      "description": "Append extra rules to system prompt",
      "flag": "--rules <TEXT>"
    },
    {
      "category": "Prompt",
      "description": "Replace system prompt entirely",
      "flag": "--system-prompt-override <TEXT>"
    },
    {
      "category": "Tools",
      "description": "Allow only these built-in tools",
      "flag": "--tools <LIST>"
    },
    {
      "category": "Tools",
      "description": "Disallow built-in tools",
      "flag": "--disallowed-tools <LIST>"
    },
    {
      "category": "Agent",
      "description": "Maximum agent turns",
      "flag": "--max-turns <N>"
    },
    {
      "category": "Agent",
      "description": "Disable planning",
      "flag": "--no-plan"
    },
    {
      "category": "Agent",
      "description": "Disable subagents",
      "flag": "--no-subagents"
    },
    {
      "category": "Agent",
      "description": "Disable memory",
      "flag": "--no-memory"
    },
    {
      "category": "Agent",
      "description": "Disable web search",
      "flag": "--disable-web-search"
    },
    {
      "category": "Agent",
      "description": "Enable cross-session memory",
      "flag": "--experimental-memory"
    },
    {
      "category": "Auth",
      "description": "Use OAuth when welcome screen starts auth",
      "flag": "--oauth"
    },
    {
      "category": "Headless",
      "description": "Headless one-shot prompt",
      "flag": "-p, --single <PROMPT>"
    },
    {
      "category": "Headless",
      "description": "plain | json | streaming-json",
      "flag": "--output-format <FMT>"
    },
    {
      "category": "Headless",
      "description": "Inline (no fullscreen TUI takeover)",
      "flag": "--no-alt-screen"
    },
    {
      "category": "Headless",
      "description": "Skip background update checks",
      "flag": "--no-auto-update"
    }
  ],
  "configPath": "~/.grok/config.toml",
  "envVars": [
    {
      "category": "Paths",
      "description": "Home for config, auth, sessions (default ~/.grok)",
      "name": "GROK_HOME"
    },
    {
      "category": "Auth",
      "description": "API key for headless / CI auth",
      "name": "XAI_API_KEY"
    },
    {
      "category": "Models",
      "description": "Session default model (= -m)",
      "name": "GROK_DEFAULT_MODEL"
    },
    {
      "category": "Models",
      "description": "Model for web_search tool",
      "name": "GROK_WEB_SEARCH_MODEL"
    },
    {
      "category": "Sandbox",
      "description": "Sandbox profile name",
      "name": "GROK_SANDBOX"
    },
    {
      "category": "CLI",
      "description": "Suppress auto-updater when set",
      "name": "GROK_DISABLE_AUTOUPDATER"
    },
    {
      "category": "Features",
      "description": "1/0 cross-session memory",
      "name": "GROK_MEMORY"
    },
    {
      "category": "Features",
      "description": "1/0 subagents / task tool",
      "name": "GROK_SUBAGENTS"
    },
    {
      "category": "Features",
      "description": "Max subagent nesting depth (default 1 = flat tree)",
      "name": "GROK_SUBAGENTS_MAX_DEPTH"
    },
    {
      "category": "Tools",
      "description": "1/0 enable web_fetch",
      "name": "GROK_WEB_FETCH"
    },
    {
      "category": "Tools",
      "description": "0 disables write tool",
      "name": "GROK_WRITE_FILE"
    },
    {
      "category": "UI",
      "description": "Color theme",
      "name": "GROK_THEME"
    },
    {
      "category": "Logging",
      "description": "Log filter e.g. debug",
      "name": "RUST_LOG"
    }
  ],
