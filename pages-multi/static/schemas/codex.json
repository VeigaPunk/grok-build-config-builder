{
  "product": "codex",
  "productTitle": "Codex Titanium",
  "productTagline": "Titanium unrestricted matches codex-titanium/titanium/config.toml",
  "configPath": "~/.codex/config.toml",
  "format": "toml",
  "versionNote": "Codex CLI · Titanium unrestricted · agents + multi_agent_v2 wired",
  "cliFlags": [
    {"category": "Session", "description": "Start interactive TUI", "flag": "codex"},
    {"category": "Session", "description": "Headless one-shot", "flag": "codex exec <PROMPT>"},
    {"category": "Config", "description": "Apply [profiles.NAME] overlay", "flag": "--profile <NAME>"},
    {"category": "Config", "description": "Override any config key", "flag": "-c / --config KEY=VALUE"},
    {"category": "Model", "description": "Model override", "flag": "-m / --model <MODEL>"},
    {"category": "Permissions", "description": "Autonomous mode", "flag": "--full-auto"},
    {"category": "Permissions", "description": "Sandbox override", "flag": "--sandbox <MODE>"},
    {"category": "Session", "description": "Working directory", "flag": "--cd <PATH>"},
    {"category": "Headless", "description": "JSON event stream (exec)", "flag": "--json"}
  ],
  "envVars": [
    {"category": "Paths", "description": "Config/state home", "name": "CODEX_HOME"},
    {"category": "Auth", "description": "API key", "name": "OPENAI_API_KEY"},
    {"category": "Auth", "description": "Base URL override", "name": "OPENAI_BASE_URL"},
    {"category": "Logging", "description": "Log filter", "name": "RUST_LOG"}
  ],
  "groups": [
    {"id": "core", "title": "Core", "description": "Model, personality, Godspeed base instructions"},
    {"id": "reasoning", "title": "Reasoning", "description": "Effort and summaries"},
    {"id": "sandbox", "title": "Sandbox & approvals", "description": "Sandbox mode and approval policy"},
    {"id": "permissions", "title": "Permissions", "description": "Permission profile"},
    {"id": "features", "title": "Features", "description": "Feature flags including multi-agent v2"},
    {"id": "agents", "title": "Agents", "description": "Agent depth, runtime, interrupt"},
    {"id": "history", "title": "History", "description": "History persistence"},
    {"id": "shell", "title": "Shell", "description": "Env inherit"},
    {"id": "project", "title": "Project", "description": "Project docs"},
    {"id": "provider", "title": "Custom provider", "description": "BYOK"},
    {"id": "web", "title": "Web search", "description": "Web search mode"}
  ],
  "fields": [
    {"id": "model", "path": "model", "section": "", "group": "core", "label": "Model", "type": "string", "default": "gpt-5.4", "recommended": true, "description": "Primary model id"},
    {"id": "model_provider", "path": "model_provider", "section": "", "group": "core", "label": "Model provider", "type": "string", "default": "openai", "recommended": true, "description": "Provider id"},
    {"id": "personality", "path": "personality", "section": "", "group": "core", "label": "Personality", "type": "enum", "options": ["pragmatic", "concise", "mentorial", "bold"], "default": "pragmatic", "description": "Agent tone"},
    {"id": "base_instructions", "path": "base_instructions", "section": "", "group": "core", "label": "Base instructions (Godspeed)", "type": "string", "recommended": true, "default": "# Godspeed Mode — Behavioral Directive\n\n1. Name the axes.\n2. Iterate cheap, in parallel.\n3. Keep moves that improve any axis and harm none.\n4. Don't aim — let the frontier walk itself.", "description": "Titanium Godspeed directive"},
    {"id": "include_collaboration_mode_instructions", "path": "include_collaboration_mode_instructions", "section": "", "group": "core", "label": "Collaboration instructions", "type": "boolean", "default": false, "description": "Include collaboration-mode instructions"},
    {"id": "model_reasoning_effort", "path": "model_reasoning_effort", "section": "", "group": "reasoning", "label": "Reasoning effort", "type": "enum", "options": ["minimal", "low", "medium", "high", "xhigh"], "default": "high", "recommended": true, "description": "Thinking effort"},
    {"id": "approval_policy", "path": "approval_policy", "section": "", "group": "sandbox", "label": "Approval policy", "type": "enum", "options": ["untrusted", "on-request", "never"], "default": "never", "recommended": true, "description": "Titanium uses never"},
    {"id": "sandbox_mode", "path": "sandbox_mode", "section": "", "group": "sandbox", "label": "Sandbox mode", "type": "enum", "options": ["read-only", "workspace-write", "danger-full-access"], "default": "danger-full-access", "recommended": true, "description": "Titanium uses danger-full-access"},
    {"id": "default_permissions", "path": "default_permissions", "section": "", "group": "permissions", "label": "Default permissions", "type": "string", "default": ":danger-full-access", "recommended": true, "description": "Permission profile"},
    {"id": "features.hooks", "path": "features.hooks", "section": "features", "group": "features", "label": "Hooks", "type": "boolean", "default": true, "recommended": true, "description": "Lifecycle hooks"},
    {"id": "features.multi_agent", "path": "features.multi_agent", "section": "features", "group": "features", "label": "Multi-agent", "type": "boolean", "default": true, "recommended": true, "description": "Multi-agent orchestration"},
    {"id": "features.multi_agent_v2.enabled", "path": "enabled", "section": "features.multi_agent_v2", "group": "features", "label": "Multi-agent v2 enabled", "type": "boolean", "default": true, "recommended": true, "description": "v2 engine"},
    {"id": "features.multi_agent_v2.max_concurrent_threads_per_session", "path": "max_concurrent_threads_per_session", "section": "features.multi_agent_v2", "group": "features", "label": "Max concurrent threads", "type": "number", "default": 64, "recommended": true, "description": "Titanium = 64"},
    {"id": "features.multi_agent_v2.expose_spawn_agent_model_overrides", "path": "expose_spawn_agent_model_overrides", "section": "features.multi_agent_v2", "group": "features", "label": "Expose spawn model overrides", "type": "boolean", "default": true, "description": "Allow model overrides on spawn"},
    {"id": "features.multi_agent_v2.subagent_usage_hint_text", "path": "subagent_usage_hint_text", "section": "features.multi_agent_v2", "group": "features", "label": "Subagent usage hint", "type": "string", "default": "Inherit only the Godspeed base directive.", "description": "Hint for subagents"},
    {"id": "features.multi_agent_v2.multi_agent_mode_hint_text", "path": "multi_agent_mode_hint_text", "section": "features.multi_agent_v2", "group": "features", "label": "Multi-agent mode hint", "type": "string", "default": "Operate as the judge: dispatch, compare, Pareto-filter, and synthesize.", "description": "Judge mode hint"},
    {"id": "features.memories", "path": "features.memories", "section": "features", "group": "features", "label": "Memories", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "features.external_agent_memory_import", "path": "features.external_agent_memory_import", "section": "features", "group": "features", "label": "External memory import", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "features.chronicle", "path": "features.chronicle", "section": "features", "group": "features", "label": "Chronicle", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "features.fast_mode", "path": "features.fast_mode", "section": "features", "group": "features", "label": "Fast mode", "type": "boolean", "default": true, "description": "Titanium enables"},
    {"id": "features.plugins", "path": "features.plugins", "section": "features", "group": "features", "label": "Plugins", "type": "boolean", "default": true, "description": "Plugins system"},
    {"id": "features.shell_snapshot", "path": "features.shell_snapshot", "section": "features", "group": "features", "label": "Shell snapshot", "type": "boolean", "default": true, "description": "Shell snapshot"},
    {"id": "features.skill_search", "path": "features.skill_search", "section": "features", "group": "features", "label": "Skill search", "type": "boolean", "default": true, "description": "Skill search"},
    {"id": "features.workspace_dependencies", "path": "features.workspace_dependencies", "section": "features", "group": "features", "label": "Workspace dependencies", "type": "boolean", "default": true, "description": "Workspace dependencies"},
    {"id": "features.concurrent_reasoning_summaries", "path": "features.concurrent_reasoning_summaries", "section": "features", "group": "features", "label": "Concurrent reasoning summaries", "type": "boolean", "default": true, "description": "Concurrent summaries"},
    {"id": "features.computer_use", "path": "features.computer_use", "section": "features", "group": "features", "label": "Computer use", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "features.in_app_browser", "path": "features.in_app_browser", "section": "features", "group": "features", "label": "In-app browser", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "features.standalone_web_search", "path": "features.standalone_web_search", "section": "features", "group": "features", "label": "Standalone web search", "type": "boolean", "default": false, "description": "Titanium hard-disables"},
    {"id": "agents.max_depth", "path": "max_depth", "section": "agents", "group": "agents", "label": "Max agent depth", "type": "number", "default": 1, "recommended": true, "description": "Titanium = 1"},
    {"id": "agents.job_max_runtime_seconds", "path": "job_max_runtime_seconds", "section": "agents", "group": "agents", "label": "Job max runtime (s)", "type": "number", "default": 1800, "description": "Titanium = 1800"},
    {"id": "agents.interrupt_message", "path": "interrupt_message", "section": "agents", "group": "agents", "label": "Interrupt message", "type": "boolean", "default": true, "description": "Interrupt support"},
    {"id": "web_search", "path": "web_search", "section": "", "group": "web", "label": "Web search mode", "type": "enum", "options": ["cached", "live", "off", "disabled"], "default": "disabled", "description": "Titanium uses disabled"},
    {"id": "history.persistence", "path": "history.persistence", "section": "history", "group": "history", "label": "History persistence", "type": "enum", "options": ["save-all", "none"], "default": "save-all", "description": "History mode"}
  ],
  "presets": [
    {
      "id": "titanium",
      "name": "Titanium (unrestricted)",
      "description": "Matches codex-titanium/titanium/config.toml unrestricted profile",
      "enabled": ["model", "model_provider", "personality", "base_instructions", "include_collaboration_mode_instructions", "model_reasoning_effort", "approval_policy", "sandbox_mode", "default_permissions", "features.hooks", "features.multi_agent", "features.multi_agent_v2.enabled", "features.multi_agent_v2.max_concurrent_threads_per_session", "features.multi_agent_v2.expose_spawn_agent_model_overrides", "features.multi_agent_v2.subagent_usage_hint_text", "features.multi_agent_v2.multi_agent_mode_hint_text", "features.memories", "features.external_agent_memory_import", "features.chronicle", "features.fast_mode", "features.plugins", "features.shell_snapshot", "features.skill_search", "features.workspace_dependencies", "features.concurrent_reasoning_summaries", "features.computer_use", "features.in_app_browser", "features.standalone_web_search", "agents.max_depth", "agents.job_max_runtime_seconds", "agents.interrupt_message", "web_search", "history.persistence"],
      "values": {
        "model": "gpt-5.4",
        "model_provider": "openai",
        "personality": "pragmatic",
        "base_instructions": "# Godspeed Mode — Behavioral Directive\n\n1. Name the axes.\n2. Iterate cheap, in parallel.\n3. Keep moves that improve any axis and harm none.\n4. Don't aim — let the frontier walk itself.",
        "include_collaboration_mode_instructions": false,
        "model_reasoning_effort": "high",
        "approval_policy": "never",
        "sandbox_mode": "danger-full-access",
        "default_permissions": ":danger-full-access",
        "features.hooks": true,
        "features.multi_agent": true,
        "features.multi_agent_v2.enabled": true,
        "features.multi_agent_v2.max_concurrent_threads_per_session": 64,
        "features.multi_agent_v2.expose_spawn_agent_model_overrides": true,
        "features.multi_agent_v2.subagent_usage_hint_text": "Inherit only the Godspeed base directive.",
        "features.multi_agent_v2.multi_agent_mode_hint_text": "Operate as the judge: dispatch, compare, Pareto-filter, and synthesize.",
        "features.memories": false,
        "features.external_agent_memory_import": false,
        "features.chronicle": false,
        "features.fast_mode": true,
        "features.plugins": true,
        "features.shell_snapshot": true,
        "features.skill_search": true,
        "features.workspace_dependencies": true,
        "features.concurrent_reasoning_summaries": true,
        "features.computer_use": false,
        "features.in_app_browser": false,
        "features.standalone_web_search": false,
        "agents.max_depth": 1,
        "agents.job_max_runtime_seconds": 1800,
        "agents.interrupt_message": true,
        "web_search": "disabled",
        "history.persistence": "save-all"
      }
    },
    {
      "id": "titanium-yolo",
      "name": "Titanium YOLO",
      "description": "Never + danger-full-access alias",
      "enabled": ["model", "approval_policy", "sandbox_mode", "default_permissions", "features.multi_agent", "features.hooks", "features.fast_mode", "features.memories"],
      "values": {
        "model": "gpt-5.4",
        "approval_policy": "never",
        "sandbox_mode": "danger-full-access",
        "default_permissions": ":danger-full-access",
        "features.multi_agent": true,
        "features.hooks": true,
        "features.fast_mode": true,
        "features.memories": false
      }
    }
  ],
  "subcommands": [
    {"cmd": "codex", "desc": "Interactive TUI"},
    {"cmd": "codex exec", "desc": "Headless"},
    {"cmd": "codex login", "desc": "Authenticate"},
    {"cmd": "codex logout", "desc": "Clear credentials"}
  ]
}
