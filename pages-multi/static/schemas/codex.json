    {
      "id": "titanium-yolo",
      "name": "Titanium YOLO",
      "description": "Alias of unrestricted Titanium with Godspeed system prompt.",
      "enabled": ["model", "approval_policy", "sandbox_mode", "base_instructions", "features.multi_agent_v2.enabled", "features.multi_agent_v2.max_concurrent_threads_per_session", "features.memories", "agents.max_depth"],
      "values": {
